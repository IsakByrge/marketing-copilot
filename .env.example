# ─────────────────────────────────────────────────────────────────────
# Marketing Copilot — environment template
#
# Copy this file to `.env.local` and fill in real values. `.env.local` is
# gitignored; this template (`.env.example`) is committed and MUST NOT
# contain real secrets — placeholders only.
#
# Legend:
#   [required]     app will not function without it
#   [optional]     has a safe code default; override only to tune
#   (public)       exposed to the browser (NEXT_PUBLIC_ prefix) — never a secret
#   (server-only)  read only in server code / route handlers — keep secret
# ─────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────
# Supabase project URL. [required] (public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key (RLS-scoped; safe to expose). [required] (public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# OpenAI API key — used for all model + image calls. [required] (server-only)
OPENAI_API_KEY=sk-your-openai-key

# ── Optional: AI models / token budget / timeouts ────────────────────
# Central chat model for create-content and shared server AI calls. [optional] (server-only)
# AI_CHAT_MODEL=gpt-4o
# Central image model (generate/edit image). [optional] (server-only)
# AI_IMAGE_MODEL=gpt-image-1
# Hard timeout (ms) for shared server AI calls. [optional] (server-only)
# AI_TIMEOUT_MS=45000
# Hard cap on model output tokens. [optional] (server-only)
# AI_MAX_OUTPUT_TOKENS=1800

# Marketing Strategist model + timeout. [optional] (server-only)
# STRATEGIST_MODEL=gpt-4o
# STRATEGIST_TIMEOUT_MS=45000

# Facebook Specialist models + timeout. [optional] (server-only)
# FACEBOOK_DRAFT_MODEL=gpt-4o
# FACEBOOK_REVIEW_MODEL=gpt-4o-mini
# FACEBOOK_TIMEOUT_MS=45000

# ── Optional: abuse / SSRF / upload limits ───────────────────────────
# In-memory rate limit: max requests per window per (user, feature). [optional] (server-only)
# AI_RATE_LIMIT_MAX=8
# Rate-limit sliding window size in ms. [optional] (server-only)
# AI_RATE_LIMIT_WINDOW_MS=60000
# SSRF-safe website fetch timeout (ms), used by /api/analyze-company. [optional] (server-only)
# WEBSITE_FETCH_TIMEOUT_MS=8000
# SSRF-safe website fetch max response size (bytes). [optional] (server-only)
# WEBSITE_FETCH_MAX_BYTES=2000000
# Max upload size (bytes) accepted by /api/edit-image. [optional] (server-only)
# EDIT_IMAGE_MAX_BYTES=4000000

# Model for the weekly plan specifically. The plan is the longest and most
# rule-bound call in the product. Falls back to AI_CHAT_MODEL, then gpt-4o-mini.
# [optional] (server-only)
# PLAN_MODEL=gpt-4o

# ── Admin ────────────────────────────────────────────────────────────
# Comma-separated emails that may see the AI usage/cost panel on /dashboard.
# Checked SERVER-SIDE in /api/usage — never trust a client-side check here.
# Unset or empty means nobody is an admin, and the panel is hidden for all.
# [optional] (server-only)
# ADMIN_EMAILS=du@dittforetag.se,kollega@dittforetag.se

# ── Tooling only (not needed at runtime) ─────────────────────────────
# Base URL the route smoke-test hits (scripts/route-smoke.mts). [optional] (tooling)
# BASE_URL=http://localhost:3000
